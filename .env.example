DJANGO_LOG_LEVEL=INFO
DJANGO_PERFORMANCE_MONITORING=True
DJANGO_PERFORMANCE_LOG_ALL=True
DJANGO_SLOW_REQUEST_MS=500
DJANGO_SLOW_DB_QUERY_MS=100

